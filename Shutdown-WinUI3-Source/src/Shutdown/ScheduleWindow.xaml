<Window
    x:Class="ShutdownApp.ScheduleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Shutdown Trey">
    <Grid x:Name="RootGrid" Padding="28" RowSpacing="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="QuestionText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <Grid x:Name="IntervalPanel" Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
            <NumberBox x:Name="IntervalNumber" Minimum="1" Maximum="10080" Value="30" SpinButtonPlacementMode="Inline"/>
            <ComboBox x:Name="UnitCombo" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem x:Name="MinutesItem"/><ComboBoxItem x:Name="HoursItem"/></ComboBox>
        </Grid>
        <Grid x:Name="DateTimePanel" Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
            <DatePicker x:Name="ActionDate" HorizontalAlignment="Stretch"/>
            <TimePicker x:Name="ActionTime" Grid.Column="1" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch"/>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="1" MinWidth="110" Click="CancelButton_Click"/>
            <Button x:Name="ScheduleButton" Grid.Column="2" MinWidth="130" Style="{StaticResource AccentButtonStyle}" Click="ScheduleButton_Click"/>
        </Grid>
    </Grid>
</Window>
