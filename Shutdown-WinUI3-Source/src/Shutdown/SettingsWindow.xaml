<Window
    x:Class="ShutdownApp.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Shutdown Trey">

    <Grid x:Name="RootGrid" Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Opacity="0.68" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="12" Padding="0,4,12,4">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ConfirmationLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="ConfirmationCombo" HorizontalAlignment="Stretch" SelectionChanged="ConfirmationCombo_SelectionChanged">
                        <ComboBoxItem x:Name="NoConfirmationItem" />
                        <ComboBoxItem x:Name="AskItem" />
                        <ComboBoxItem x:Name="CountdownItem" />
                    </ComboBox>
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="DefaultActionLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="DefaultActionHint" Opacity="0.68" />
                    </StackPanel>
                    <ComboBox x:Name="DefaultActionCombo" Grid.Column="1" HorizontalAlignment="Stretch">
                        <ComboBoxItem x:Name="DefaultShutdownItem" />
                        <ComboBoxItem x:Name="DefaultRestartItem" />
                    </ComboBox>
                </Grid>

                <Grid x:Name="CountdownRow" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="CountdownLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="CountdownHint" Opacity="0.68" />
                    </StackPanel>
                    <NumberBox x:Name="CountdownNumber" Grid.Column="1" Minimum="1" Maximum="300"
                               SpinButtonPlacementMode="Inline" SmallChange="1" />
                </Grid>

                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="RdpMenuLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="RdpMenuHint" Opacity="0.68" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RdpMenuToggle" Grid.Column="1" OffContent="" OnContent="" />
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="HotkeyLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Ctrl+Alt+Shift+Q" Opacity="0.68" />
                    </StackPanel>
                    <ToggleSwitch x:Name="HotkeyToggle" Grid.Column="1" OffContent="" OnContent="" />
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="AutostartLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="AutostartHint" Opacity="0.68" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutostartToggle" Grid.Column="1" OffContent="" OnContent="" />
                </Grid>

                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" HorizontalAlignment="Stretch">
                        <ComboBoxItem x:Name="SystemThemeItem" />
                        <ComboBoxItem x:Name="LightThemeItem" />
                        <ComboBoxItem x:Name="DarkThemeItem" />
                    </ComboBox>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Русский" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                </Grid>

                <StackPanel Spacing="3" Margin="0,6,0,0">
                    <TextBlock Text="Shutdown Trey 1.0.1" FontWeight="SemiBold" />
                    <TextBlock Text="sol669" Opacity="0.68" />
                    <HyperlinkButton Content="github.com/sol669/Shutdown"
                                     NavigateUri="https://github.com/sol669/Shutdown"
                                     Padding="0" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="12" Padding="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="1" MinWidth="110" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Grid.Column="2" MinWidth="110" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Window>
