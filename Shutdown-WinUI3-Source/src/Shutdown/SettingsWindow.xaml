<Window
    x:Class="ShutdownApp.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Shutdown Trey">

    <Grid x:Name="RootGrid" Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock x:Name="ActionsSection" FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,2,0,0" />
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ShutdownLabel" VerticalAlignment="Center"/><ToggleSwitch x:Name="ShutdownToggle" Grid.Column="1" OffContent="" OnContent="" Toggled="ActionToggle_Toggled"/></Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="RestartLabel" VerticalAlignment="Center"/><ToggleSwitch x:Name="RestartToggle" Grid.Column="1" OffContent="" OnContent="" Toggled="ActionToggle_Toggled"/></Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SleepLabel" VerticalAlignment="Center"/><ToggleSwitch x:Name="SleepToggle" Grid.Column="1" OffContent="" OnContent="" Toggled="ActionToggle_Toggled"/></Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HibernateLabel" VerticalAlignment="Center"/><ToggleSwitch x:Name="HibernateToggle" Grid.Column="1" OffContent="" OnContent="" Toggled="ActionToggle_Toggled"/></Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LockLabel" VerticalAlignment="Center"/><ToggleSwitch x:Name="LockToggle" Grid.Column="1" OffContent="" OnContent="" Toggled="ActionToggle_Toggled"/></Grid>
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock x:Name="DefaultActionLabel" VerticalAlignment="Center"/><ComboBox x:Name="DefaultActionCombo" Grid.Column="1" HorizontalAlignment="Stretch"/></Grid>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2"/>
            <TextBlock x:Name="ConfirmationSection" FontSize="12" FontWeight="SemiBold" Opacity="0.65"/>
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock x:Name="ConfirmationLabel" VerticalAlignment="Center"/><ComboBox x:Name="ConfirmationCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ConfirmationCombo_SelectionChanged"><ComboBoxItem x:Name="NoConfirmationItem"/><ComboBoxItem x:Name="AskItem"/><ComboBoxItem x:Name="CountdownItem"/></ComboBox></Grid>
            <Grid x:Name="CountdownRow" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock x:Name="CountdownLabel" VerticalAlignment="Center"/><NumberBox x:Name="CountdownNumber" Grid.Column="1" Minimum="1" Maximum="300" SpinButtonPlacementMode="Inline"/></Grid>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2"/>
            <TextBlock x:Name="ScheduledSection" FontSize="12" FontWeight="SemiBold" Opacity="0.65"/>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ScheduledMenuLabel" VerticalAlignment="Center"/><ToggleSwitch x:Name="ScheduledMenuToggle" Grid.Column="1" OffContent="" OnContent=""/></Grid>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2"/>
            <TextBlock x:Name="IntegrationSection" FontSize="12" FontWeight="SemiBold" Opacity="0.65"/>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="RdpLabel" VerticalAlignment="Center"/><ToggleSwitch x:Name="RdpToggle" Grid.Column="1" OffContent="" OnContent=""/></Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="AutostartLabel" VerticalAlignment="Center"/><ToggleSwitch x:Name="AutostartToggle" Grid.Column="1" OffContent="" OnContent=""/></Grid>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2"/>
            <TextBlock x:Name="InterfaceSection" FontSize="12" FontWeight="SemiBold" Opacity="0.65"/>
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock x:Name="ThemeLabel" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" HorizontalAlignment="Stretch"><ComboBoxItem x:Name="SystemThemeItem"/><ComboBoxItem x:Name="LightThemeItem"/><ComboBoxItem x:Name="DarkThemeItem"/></ComboBox></Grid>
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock x:Name="LanguageLabel" VerticalAlignment="Center"/><ComboBox x:Name="LanguageCombo" Grid.Column="1" HorizontalAlignment="Stretch"><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/></ComboBox></Grid>

            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                <TextBlock Text="Shutdown Trey 1.1.0 · sol669 ·" VerticalAlignment="Center" Opacity="0.68"/>
                <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/sol669/Shutdown" Padding="0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12" Padding="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="1" MinWidth="110" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Grid.Column="2" MinWidth="110" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
